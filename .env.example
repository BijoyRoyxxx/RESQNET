RESQ_AI_MODE=auto
RESQ_OLLAMA_URL=http://127.0.0.1:11434
RESQ_OLLAMA_MODEL=gemma3:1b
RESQ_OLLAMA_TIMEOUT=40
RESQ_DATABASE_URL=sqlite:///./runtime/resq.db
RESQ_MEDIA_DIR=runtime/media
RESQ_STORAGE_URL=
RESQ_STORAGE_SERVICE_KEY=
RESQ_STORAGE_BUCKET=resqnet-private
# Optional one-time admin provisioning. Remove the password secret after first deploy.
RESQ_BOOTSTRAP_ADMIN_EMAIL=
RESQ_BOOTSTRAP_ADMIN_PASSWORD=
RESQ_BOOTSTRAP_ADMIN_NAME=RESQNET Administrator
RESQ_SECURE_COOKIES=false
# Add the actual deployment hostname for direct backend hosting; use secure cookies with HTTPS.
RESQ_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","backend"]
RESQ_MATCH_THRESHOLD=0.62
RESQ_VOICE_ENABLED=false
RESQ_WHISPER_MODEL=small
RESQ_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
RESQ_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
# Map OSM facility IDs to explicitly authorized responder HTTPS gateways. Empty means no external alert delivery.
RESQ_RESPONDER_WEBHOOKS={}
RESQ_RESPONDER_TOKEN=
